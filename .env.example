# Copie este arquivo para ".env" (na raiz do projeto) e preencha SÓ no seu computador.
# O ".env" NUNCA vai para o Git. Aqui ficam apenas os NOMES, sem valores reais.

# ---- Frontend (valores públicos; VITE_* vai para o navegador) ----
# NUNCA coloque service role, JWT secret, senha ou chave privada em variável VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Backend (Netlify Functions) ----
# Em produção, estes valores ficam só no painel do Netlify.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Endereço do site (desenvolvimento: http://localhost:8888)
APP_BASE_URL=http://localhost:8888

# Cookie de sessão. Desenvolvimento: jm_session (sem Secure).
# Produção: __Host-jm_session (com Secure).
COOKIE_NAME=jm_session
COOKIE_MAX_AGE_SECONDS=7200

RATE_LIMIT_SECRET=
INTERNAL_JOB_SECRET=

# ---- E-mail ----
# Desenvolvimento: MAIL_MODE=console (o e-mail aparece no terminal, nada é enviado).
# MAIL_MODE=smtp só no Netlify de produção. A senha do Gmail fica só com o Carlos.
MAIL_MODE=console
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Jhullymaison
ADMIN_NOTIFICATION_EMAIL=
